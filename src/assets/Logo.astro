---
type Props = {
  height?: number;
  width?: number;
};

const { height = 100, width = 100 } = Astro.props;

const viewboxHeight = 10;
const viewboxWidth = 10;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${viewboxHeight} ${viewboxWidth}`}
  x="0"
  y="0"
  class="icon-toggle"
  aria-expanded="false"
  height={`${height}`}
  width={`${width}`}
>
  <!-- bg-grid: visual helper -->
  <!-- <g>
        {[...Array(viewboxWidth+1).keys()].map((i) =>
            <line 
                x1={i} x2={i}
                y1={0} y2={viewboxHeight}
                style="stroke: var(--clr-primary-transparent); stroke-width: 0.02;"
            />
        )}

        {[...Array(viewboxHeight+1).keys()].map((i) =>
            <line 
                x1={0} x2={viewboxWidth}
                y1={i} y2={i}
                style="stroke: var(--clr-primary-transparent); stroke-width: 0.02;"
            />
        )}
    </g> -->

  <g fill="var(--clr-primary)" fill-rule="evenodd">
    <path
      d="
                M5,1 
                l-4,0
                l0, 5
                Q 1,9.5 5,9.5 T 9, 6
            "
    ></path>

    <path
      d="
                M9,6 
                l0,-5
                l-3.67, 0
                v 6
                Q 3.4,7.5 3,8.5
            "
    ></path>

    <rect
      x="1.8"
      y="3"
      width="3"
      height="1.4"
      rx="5"
      transform="translate(0.4,-0.5) rotate(8)"></rect>
  </g>
</svg>

<style>
  .icon-toggle[aria-expanded="true"] .path1 {
    d: path("M8,2 L2,8");
  }

  .icon-toggle[aria-expanded="true"] .path3 {
    d: path("M8,8 L2,2");
  }

  .icon-toggle[aria-expanded="true"] .path2 {
    d: path("M8,5 L8,5");
  }

  svg {
    /* width: 30%; */
    height: 70%;
    /* background: #eeeeeeb4; */
    /* margin-bottom: 5%; */
  }

  svg polyline,
  svg line,
  svg path {
    fill: none;
    stroke: var(--clr-neutral);
    stroke-linecap: round;
    /* stroke-linejoin: round; */
    transition: 150ms;
  }
</style>
