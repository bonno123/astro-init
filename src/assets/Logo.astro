---
type Props = {
  height?: number;
  width?: number;
  /** Highlight when on home route. */
  isHome?: boolean;
};

const { height = 40, width = 40, isHome = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  class={`logo-svg ${isHome ? "logo--active" : ""}`}
  height={`${height}`}
  width={`${width}`}
  aria-label="Logo"
>
  <!-- Seven-segment display style "A" -->
  <g class="segment-display">
    <!-- Top horizontal segment -->
    <path
      class="segment segment-top"
      d="M 30 25 L 35 30 L 65 30 L 70 25 L 65 20 L 35 20 Z"></path>

    <!-- Top-left vertical segment -->
    <path
      class="segment segment-top-left"
      d="M 25 30 L 30 35 L 30 48 L 25 53 L 20 48 L 20 35 Z"></path>

    <!-- Top-right vertical segment -->
    <path
      class="segment segment-top-right"
      d="M 70 35 L 75 30 L 80 35 L 80 48 L 75 53 L 70 48 Z"></path>

    <!-- Middle horizontal segment -->
    <path
      class="segment segment-middle"
      d="M 30 50 L 35 55 L 65 55 L 70 50 L 65 45 L 35 45 Z"></path>

    <!-- Bottom-left vertical segment -->
    <path
      class="segment segment-bottom-left"
      d="M 20 52 L 25 47 L 30 52 L 30 72 L 25 77 L 20 72 Z"></path>

    <!-- Bottom-right vertical segment -->
    <path
      class="segment segment-bottom-right"
      d="M 70 52 L 75 47 L 80 52 L 80 72 L 75 77 L 70 72 Z"></path>
  </g>
</svg>

<style>
  .logo-svg {
    display: block;
    transition: all 0.3s ease;
  }

  /* Seven-segment display segments */
  .segment {
    fill: rgba(15, 23, 42, 0.12);
    transition:
      fill 0.3s ease,
      filter 0.3s ease;
  }

  /* Inactive state - dim segments */
  .logo-svg:not(.logo--active) .segment {
    fill: rgba(15, 23, 42, 0.12);
    filter: brightness(0.8);
  }

  /* Active state (homepage) - light up segments with cyan */
  .logo-svg.logo--active .segment {
    fill: #06b6d4;
    filter: drop-shadow(0 0 3px rgba(6, 182, 212, 0.6)) brightness(1.2);
  }

  /* Hover state - light up segments */
  .logo-svg:hover .segment {
    fill: #06b6d4;
    filter: drop-shadow(0 0 3px rgba(6, 182, 212, 0.5)) brightness(1.1);
  }

  /* Active + hover - gradient glow effect */
  .logo-svg.logo--active:hover .segment-top,
  .logo-svg.logo--active:hover .segment-top-right,
  .logo-svg.logo--active:hover .segment-bottom-right {
    fill: #ef4444;
    filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.6)) brightness(1.2);
  }
</style>
