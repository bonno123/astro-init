---
import QuietLayout from "~/layouts/QuietLayout.astro";
import { site } from "~/data/home";
---

<QuietLayout title="Not found" metaDescription="This page isn't here.">
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" class="lost">
    <span class="meta accent">404</span>
    <h1>Off the map.</h1>
    <p class="dek">There's nothing at this address. The site is one page now, so most old links lead home.</p>
    <a class="home mono" href="/">← back to {site.domain}</a>
    <p class="meta fig">fig. 404: an unsurveyed area</p>
  </main>
</QuietLayout>

<style>
  .lost {
    min-height: 100svh;
    /* full width for the rings; the text column stays ~640px */
    padding: 0 max(var(--pad), calc((100% - 640px) / 2));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    /* faint contour rings, like the hero's fallback */
    background: repeating-radial-gradient(
      ellipse 70% 90% at 85% 30%,
      transparent 0 27px,
      rgb(236 233 224 / 0.045) 27px 28px
    );
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(40px, 8vw, 64px);
    line-height: 1.05;
  }

  .dek {
    margin: 0;
    color: var(--muted);
    max-width: 44ch;
  }

  .home {
    margin-top: 8px;
    color: var(--accent);
    text-decoration: none;
    font-size: 13px;
  }

  .home:hover {
    text-decoration: underline;
  }

  .fig {
    margin-top: 32px;
  }
</style>
