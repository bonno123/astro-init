---
import Layout from "~/layouts/LandingLayout.astro";

import Hero from "~/components/widgets/Hero.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

const metadata = {
  title: "Lead Generation Landing Page Demo",
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero
    tagline="pave it or relax"
    title="Choose a path. Organize your life"
    subtitle="A proposed platform for getting the direction"
    actions={[
      {
        variant: "primary",
        text: "skip through",
        href: "#",
        icon: "tabler:square-rounded-arrow-right",
      },
      { text: "Play a role", href: "#" },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1633888284848-41f2472f257e?q=80&w=1632&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
      alt: "Magnet attracting screws. Lead generation landing page demo",
    }}
  />

  <CallToAction
    title="Coming soon"
    subtitle="We are working on the content of these demo pages. You will see them very soon. Stay tuned Stay tuned!"
    actions={[
      {
        variant: "primary",
        text: "Download Template",
        href: "https://github.com/onwidget/astrowind",
        icon: "tabler:download",
      },
    ]}
  />
</Layout>
