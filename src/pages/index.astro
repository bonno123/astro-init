---
import MainLayout from "~/layouts/MainLayout.astro";
---

<MainLayout
  title="Home"
  metaDescription="Full-stack developer from Kolkata building web apps, dashboards, Web3 integrations, and useful experiments with Astro, Vue, and Cloudflare."
>
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Avik Banik / full-stack dev</p>
          <h1 class="hero-title">
            I build web apps, dashboards, weird experiments, and occasionally
            <span class="text-gradient">my own problems.</span>
          </h1>
          <p class="hero-description">
            Full-stack dev from Kolkata. I work with Astro, Vue, Web3,
            Cloudflare, and whatever else the project threatens me with.
          </p>

          <div class="proof-bar" aria-label="Quick status">
            <div class="proof-item">
              <span class="proof-value">30+</span>
              <span class="proof-label">things shipped</span>
            </div>
            <div class="proof-divider"></div>
            <div class="proof-item">
              <span class="proof-value">critical</span>
              <span class="proof-label">chai level</span>
            </div>
            <div class="proof-divider"></div>
            <div class="proof-item">
              <span class="proof-value">Web3</span>
              <span class="proof-label">bugs survived</span>
            </div>
          </div>

          <div class="cta-buttons">
            <a href="/contact/" class="btn btn-primary">Send the problem</a>
            <a href="/projects/" class="btn btn-ghost">See work</a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Developer control panel">
          <div class="control-panel">
            <div class="panel-header">
              <div class="window-dots" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="panel-title">avik.dev/control-panel</span>
              <span class="panel-status">live</span>
            </div>

            <div class="panel-screen">
              <div class="terminal-card">
                <p class="terminal-line">
                  <span>$</span> whoami
                </p>
                <p class="terminal-output">
                  builder of useful interfaces, strange prototypes, and deploys
                  that behave.
                </p>
              </div>

              <div class="status-grid">
                <div class="status-card status-card-red">
                  <span class="status-label">current task</span>
                  <strong>shipping</strong>
                </div>
                <div class="status-card">
                  <span class="status-label">bugs found</span>
                  <strong>before users</strong>
                </div>
                <div class="status-card">
                  <span class="status-label">wallet popup</span>
                  <strong>negotiating</strong>
                </div>
                <div class="status-card status-card-cyan">
                  <span class="status-label">deploy status</span>
                  <strong>still standing</strong>
                </div>
              </div>

              <div class="deploy-log">
                <div class="log-row">
                  <span class="log-time">03:14</span>
                  <span>pushed fix with suspicious confidence</span>
                </div>
                <div class="log-row">
                  <span class="log-time">03:18</span>
                  <span>Cloudflare said yes</span>
                </div>
                <div class="log-row">
                  <span class="log-time">03:21</span>
                  <span>opened chai refill ticket</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="marquee-section" aria-label="Stack and keywords">
    <div class="marquee-track">
      <span>
        ASTRO - VUE - CLOUDFLARE - WEB3 - DASHBOARDS - CHAOS MANAGEMENT -
        KOLKATA - SHIPPING -
      </span>
      <span aria-hidden="true">
        ASTRO - VUE - CLOUDFLARE - WEB3 - DASHBOARDS - CHAOS MANAGEMENT -
        KOLKATA - SHIPPING -
      </span>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">What I Do</p>
        <h2>Stuff people usually ask me to fix/build</h2>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">01</div>
          <h3>Web apps that stop being vague ideas</h3>
          <p>
            Product flows, dashboards, admin panels, and frontends that need to
            feel fast without becoming a pile of mystery state.
          </p>
          <ul class="service-stack">
            <li>Astro</li>
            <li>Vue</li>
            <li>React</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon">02</div>
          <h3>Web3 integrations with fewer jump scares</h3>
          <p>
            Wallet flows, protocol dashboards, token/NFT experiences, and the
            UI glue around contracts where users can actually understand what is
            happening.
          </p>
          <ul class="service-stack">
            <li>Wallets</li>
            <li>DeFi</li>
            <li>NFTs</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon">03</div>
          <h3>Deployments that do not need a ritual</h3>
          <p>
            Cloudflare, workers, databases, build pipelines, and performance
            cleanup so the thing keeps working after the exciting demo.
          </p>
          <ul class="service-stack">
            <li>Cloudflare</li>
            <li>CI/CD</li>
            <li>Workers</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon">04</div>
          <h3>Technical direction before the sprint gets weird</h3>
          <p>
            Scope, architecture, prototypes, and product cleanup for teams that
            need a clear path from “we should build this” to “it is live.”
          </p>
          <ul class="service-stack">
            <li>Architecture</li>
            <li>Prototypes</li>
            <li>MVPs</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="work-section">
    <div class="container">
      <div class="section-header-split">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h2>Things shipped without deleting production</h2>
        </div>
        <a href="/projects/" class="btn btn-secondary">View all projects</a>
      </div>

      <div class="projects-list">
        <article class="project-card">
          <div class="project-meta">
            <span class="project-tag">DeFi</span>
            <span class="project-date">survived mainnet</span>
          </div>
          <h3>The wallet connection war</h3>
          <p>
            Real-time analytics for a Solana liquidity protocol, built with
            Astro, Vue, and Anchor program integrations.
          </p>
          <blockquote>"It connects now. Nobody touch anything."</blockquote>
          <div class="project-metrics">
            <div class="metric">
              <span class="metric-value">$2M+</span>
              <span class="metric-label">TVL tracked</span>
            </div>
            <div class="metric">
              <span class="metric-value">98%</span>
              <span class="metric-label">uptime</span>
            </div>
          </div>
          <a href="/projects/" class="project-link">View case study</a>
        </article>

        <article class="project-card">
          <div class="project-meta">
            <span class="project-tag">Web3</span>
            <span class="project-date">mint button behaved</span>
          </div>
          <h3>Tiny app, suspiciously useful</h3>
          <p>
            Custom marketplace experience with authentication, gasless
            transactions, and a mint flow that got out of the user's way.
          </p>
          <blockquote>"I did not think this was possible this week."</blockquote>
          <div class="project-metrics">
            <div class="metric">
              <span class="metric-value">10K+</span>
              <span class="metric-label">mints</span>
            </div>
            <div class="metric">
              <span class="metric-value">&lt;1s</span>
              <span class="metric-label">mint time</span>
            </div>
          </div>
          <a href="/projects/" class="project-link">View case study</a>
        </article>

        <article class="project-card">
          <div class="project-meta">
            <span class="project-tag">SaaS</span>
            <span class="project-date">charts calmed down</span>
          </div>
          <h3>The one with too many charts</h3>
          <p>
            Real-time analytics dashboard processing high-volume events with
            edge deployment and a calmer interface for repeat daily use.
          </p>
          <blockquote>"We do not talk about the first spreadsheet."</blockquote>
          <div class="project-metrics">
            <div class="metric">
              <span class="metric-value">250ms</span>
              <span class="metric-label">p95 latency</span>
            </div>
            <div class="metric">
              <span class="metric-value">99.9%</span>
              <span class="metric-label">availability</span>
            </div>
          </div>
          <a href="/projects/" class="project-link">View case study</a>
        </article>
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">How It Usually Goes</p>
        <h2>Small process, fewer surprises</h2>
      </div>

      <div class="process-strip">
        <div class="process-step">
          <div class="step-number">01</div>
          <h3>Untangle</h3>
          <p>Goals, constraints, users, scary edge cases, and what matters now.</p>
        </div>
        <div class="process-arrow">-</div>

        <div class="process-step">
          <div class="step-number">02</div>
          <h3>Shape</h3>
          <p>Prototype the flow, choose the stack, and remove vague parts.</p>
        </div>
        <div class="process-arrow">-</div>

        <div class="process-step">
          <div class="step-number">03</div>
          <h3>Build</h3>
          <p>Ship in visible chunks with demos before assumptions get expensive.</p>
        </div>
        <div class="process-arrow">-</div>

        <div class="process-step">
          <div class="step-number">04</div>
          <h3>Launch</h3>
          <p>Deploy, monitor, document the useful bits, and clean up the mess.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <p class="eyebrow">Contact</p>
        <h2>Send the problem</h2>
        <p>
          Tell me what you are building, what is broken, or what needs to exist
          before Friday.
        </p>
        <div class="cta-buttons">
          <a href="/contact/" class="btn btn-primary btn-lg">Start a thread</a>
          <a href="mailto:hello@avikb.dev" class="btn btn-ghost-light btn-lg">
            Email me
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :global(body) {
    background: #fff7df;
  }

  .hero-section {
    padding: 3rem 0 4rem;
    background:
      linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      #fff7df;
    background-size: 28px 28px;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 5rem 0 5rem;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.9fr);
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-title {
    max-width: 820px;
    font-size: clamp(2.6rem, 6vw, 5.35rem);
    line-height: 0.98;
    margin: 0;
    color: #111827;
    letter-spacing: 0;
  }

  .hero-description {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    color: #334155;
    max-width: 640px;
  }

  .text-gradient {
    background: linear-gradient(135deg, #06b6d4 0%, #ef4444 82%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .proof-bar {
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 0;
    border: 2px solid #111827;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 8px 8px 0 #111827;
    max-width: 680px;
  }

  .proof-item {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem;
  }

  .proof-value {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 700;
    color: #ef4444;
    white-space: nowrap;
  }

  .proof-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #475569;
  }

  .proof-divider {
    width: 2px;
    background: #111827;
  }

  .hero-visual {
    position: relative;
  }

  .control-panel {
    border: 3px solid #111827;
    border-radius: 8px;
    background: #111827;
    box-shadow: 14px 14px 0 #ef4444;
    overflow: hidden;
    transform: rotate(1.25deg);
  }

  .panel-header {
    min-height: 3rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 1rem;
    color: #f8fafc;
    border-bottom: 3px solid #111827;
    background: #06b6d4;
  }

  .window-dots {
    display: flex;
    gap: 0.4rem;
  }

  .window-dots span {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid #111827;
    border-radius: 999px;
    background: #fff7df;
  }

  .window-dots span:nth-child(2) {
    background: #facc15;
  }

  .window-dots span:nth-child(3) {
    background: #ef4444;
  }

  .panel-title,
  .panel-status,
  .terminal-line,
  .terminal-output,
  .status-label,
  .log-row {
    font-family: var(--font-mono);
  }

  .panel-title {
    min-width: 0;
    flex: 1;
    color: #111827;
    font-size: 0.85rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .panel-status {
    color: #111827;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border: 2px solid #111827;
    border-radius: 999px;
    background: #fff7df;
  }

  .panel-screen {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    background: #f8fafc;
  }

  .terminal-card,
  .status-card,
  .deploy-log {
    border: 2px solid #111827;
    border-radius: 8px;
    background: #ffffff;
  }

  .terminal-card {
    padding: 1rem;
  }

  .terminal-line {
    margin: 0 0 0.75rem;
    color: #111827;
    font-weight: 700;
  }

  .terminal-line span {
    color: #ef4444;
  }

  .terminal-output {
    margin: 0;
    color: #334155;
    line-height: 1.6;
    font-size: 0.92rem;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .status-card {
    min-height: 92px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem;
  }

  .status-card-red {
    background: #fee2e2;
  }

  .status-card-cyan {
    background: #cffafe;
  }

  .status-label {
    color: #475569;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status-card strong {
    color: #111827;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.1;
  }

  .deploy-log {
    display: grid;
    overflow: hidden;
  }

  .log-row {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: #334155;
    font-size: 0.82rem;
    border-bottom: 2px solid #111827;
  }

  .log-row:last-child {
    border-bottom: 0;
  }

  .log-time {
    color: #ef4444;
    font-weight: 700;
  }

  .marquee-section {
    overflow: hidden;
    border-block: 3px solid #111827;
    background: #ef4444;
    color: #fff7df;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 22s linear infinite;
  }

  .marquee-track span {
    display: inline-flex;
    padding: 0.9rem 0;
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .services-section,
  .process-section {
    padding: 3rem 0;
    background: #fff7df;
  }

  @media (min-width: 768px) {
    .services-section,
    .process-section {
      padding: 5rem 0;
    }
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    max-width: 760px;
    margin: 0.5rem auto 0;
    color: #111827;
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .service-card {
    background: #ffffff;
    padding: 1.5rem;
    border-radius: 8px;
    border: 2px solid #111827;
    box-shadow: 6px 6px 0 rgba(17, 24, 39, 0.18);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .service-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 9px 0 rgba(17, 24, 39, 0.2);
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    border: 2px solid #111827;
    border-radius: 8px;
    background: #cffafe;
    color: #111827;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .service-card h3 {
    color: #111827;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0;
  }

  .service-card p {
    color: #475569;
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .service-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .service-stack li {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    background: #fff7df;
    color: #111827;
    border: 1px solid #111827;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .work-section {
    padding: 3rem 0;
    background: #111827;
    color: #f8fafc;
  }

  @media (min-width: 768px) {
    .work-section {
      padding: 5rem 0;
    }
  }

  .work-section h2,
  .work-section h3 {
    color: #f8fafc;
    letter-spacing: 0;
  }

  .work-section .eyebrow {
    color: #67e8f9;
  }

  .section-header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .section-header-split h2 {
    max-width: 760px;
    margin-top: 0.5rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .projects-list {
    display: grid;
    gap: 1.25rem;
  }

  .project-card {
    background: #1f2937;
    padding: 1.5rem;
    border-radius: 8px;
    border: 2px solid #f8fafc;
    box-shadow: 7px 7px 0 #06b6d4;
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .project-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 #ef4444;
  }

  .project-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .project-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: #fee2e2;
    color: #991b1b;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-date {
    font-size: 0.8rem;
    color: #cbd5e1;
    font-family: var(--font-mono);
  }

  .project-card h3 {
    font-size: clamp(1.45rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
  }

  .project-card > p {
    color: #cbd5e1;
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .project-card blockquote {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 4px solid #ef4444;
    background: rgba(248, 250, 252, 0.08);
    color: #f8fafc;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .project-metrics {
    display: flex;
    gap: 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.45rem;
    font-weight: 700;
    color: #67e8f9;
  }

  .metric-label {
    font-size: 0.72rem;
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #67e8f9;
    font-weight: 700;
    transition: gap 250ms ease;
  }

  .project-link::after {
    content: "->";
    font-family: var(--font-mono);
  }

  .project-link:hover {
    gap: 0.75rem;
  }

  .process-strip {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
  }

  .process-step {
    flex: 1;
    padding: 1.25rem;
    text-align: left;
    background: #ffffff;
    border: 2px solid #111827;
    border-radius: 8px;
  }

  .step-number {
    display: inline-flex;
