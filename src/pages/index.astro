---
import MainLayout from "~/layouts/MainLayout.astro";
import Hero from "~/components/Hero.astro";
import RadarAnimation from "~/canvases/radarAnimation.astro";
import { heroWidget } from "~/data/site-info";
import EvenColumnsLayout from "~/layouts/EvenColumnsLayout.astro";
---

<MainLayout title={heroWidget.title} metaDescription={heroWidget.description}>
  <EvenColumnsLayout class="hero-section padding-block-700">
    <div class="hero-stack">
      <p class="eyebrow">Available for new freelance projects</p>
      <Hero
        title={heroWidget.heroContent.title}
        description={heroWidget.heroContent.description}
      />

      <!-- <div class="cta-buttons margin-top-500">
        <a href="/projects" class="btn btn-primary btn-lg">View projects</a>
        <a href="/contact" class="btn btn-ghost btn-lg">Book a call</a>
      </div> -->

      <!-- <p class="hero-meta">
        Independent developer crafting fast, minimal, conversion-focused sites.
      </p> -->

      <div class="cta-buttons mt-96">
        <a href="/projects/" class="btn btn-primary btn-lg">View projects</a>
        <a href="/contact/" class="btn btn-ghost btn-lg">Book a call</a>
      </div>
    </div>

    <div class="visual-panel">
      <div class="radar-wrapper">
        <RadarAnimation />
      </div>
      <div class="panel-footer">
        <span>Interactive WebGL demo</span>
        <span class="dot" aria-hidden="true"></span>
        <span>Performance-first builds</span>
      </div>
    </div>
  </EvenColumnsLayout>

  <section class="testimonials padding-block-800">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2 class="fs-secondary-heading fw-bold">What clients say</h2>
          <p class="text-muted" data-width="wide">
            Early in the freelance journey—your project could be the next
            featured story. Placeholders stand in until real feedback arrives.
          </p>
        </div>
        <a href="/contact/" class="btn btn-primary">Add yours</a>
      </div>

      <div class="testimonial-grid margin-top-500">
        <article class="testimonial-card">
          <div class="avatar" aria-hidden="true"></div>
          <p class="quote">
            “Avik delivered our site ahead of schedule with a smooth handoff.”
          </p>
          <p class="client">Future Client · SaaS</p>
        </article>
        <article class="testimonial-card">
          <div class="avatar" aria-hidden="true"></div>
          <p class="quote">
            “Great communication, thoughtful design choices, and fast
            performance.”
          </p>
          <p class="client">Future Client · E‑commerce</p>
        </article>
        <article class="testimonial-card muted">
          <div class="placeholder">Your testimonial could be here.</div>
        </article>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero-section {
    padding-top: 2rem;
  }

  .hero-stack {
    display: grid;
    gap: 1rem;
    max-width: 560px;
  }

  .eyebrow {
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-text-subtle, #556070);
    /* margin: 0; */
  }

  .visual-panel {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: 16px;
    padding: 1rem;
    box-shadow: 0 16px 60px rgba(0, 0, 0, 0.08);
    display: grid;
    gap: 0.75rem;
  }

  .radar-wrapper {
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(255, 255, 255, 0.4),
      rgba(255, 255, 255, 0)
    );
  }

  .panel-footer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--clr-text-subtle, #556070);
  }

  .dot {
    width: 6px;
    height: 6px;
    background: var(--clr-accent);
    border-radius: 999px;
    display: inline-block;
  }

  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .btn-lg {
    font-size: 1rem;
  }

  .btn-primary {
    background: var(--clr-accent);
    color: white;
    box-shadow: none;
  }

  .btn-primary:hover {
    background: var(--clr-accent-light);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--clr-neutral);
    border-color: var(--clr-border);
  }

  .btn-ghost:hover {
    border-color: var(--clr-accent);
    color: var(--clr-accent);
    transform: translateY(-1px);
  }

  .hero-meta {
    color: hsl(220, 14%, 40%);
    max-width: 42ch;
  }

  @media (max-width: 55em) {
    .cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }

  .testimonials {
    background: var(--clr-primary-transparent, rgba(0, 0, 0, 0.05));
    border-radius: 12px;
    margin-top: 4rem;
    margin-bottom: 4rem;
  }

  .testimonials .container {
    max-width: 1100px;
    margin-inline: auto;
    padding-block: 3.5rem;
    padding-inline: 1rem;
    display: grid;
    gap: 2.5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .text-muted {
    color: var(--clr-text-subtle, #556070);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .testimonial-card {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
    display: grid;
    gap: 0.5rem;
  }

  .testimonial-card.muted {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-text-subtle, #556070);
    text-align: center;
    font-weight: 600;
    min-height: 160px;
  }

  .placeholder {
    opacity: 0.7;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      var(--clr-accent),
      var(--clr-accent-light)
    );
    opacity: 0.9;
  }

  .quote {
    font-weight: 600;
    color: var(--clr-neutral);
  }

  .client {
    color: var(--clr-text-subtle, #556070);
    font-weight: 500;
  }

  @media (max-width: 55em) {
    .visual-panel {
      order: -1;
    }
  }
</style>
