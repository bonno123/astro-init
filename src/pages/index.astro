---
import MainLayout from "~/layouts/MainLayout.astro";
import Hero from "~/components/Hero.astro";
import RadarAnimation from "~/canvases/radarAnimation.astro";
import { heroWidget } from "~/data/site-info";
import EvenColumnsLayout from "~/layouts/EvenColumnsLayout.astro";
---

<MainLayout title={heroWidget.title} metaDescription={heroWidget.description}>
  <EvenColumnsLayout>
    <Hero
      title={heroWidget.heroContent.title}
      description={heroWidget.heroContent.description}
    />

    <div class="radar-wrapper">
      <RadarAnimation />
    </div>
  </EvenColumnsLayout>
</MainLayout>

<style>
  .radar-wrapper {
    aspect-ratio: 1 / 1;
  }
</style>
