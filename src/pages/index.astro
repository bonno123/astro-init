---
import QuietLayout from "~/layouts/QuietLayout.astro";
import ContourField from "~/components/quiet/ContourField.astro";
import Section from "~/components/quiet/Section.astro";
import Footer from "~/components/quiet/Footer.astro";
import SayHi from "~/components/quiet/SayHi.vue";
import VisitorsBook from "~/components/quiet/VisitorsBook.vue";
import {
  site,
  currently,
  visibleMoney as vm,
  bardhamanConnect as bc,
  essays,
  alsoMade,
  people,
  life,
  asks,
  declared,
  photo,
} from "~/data/home";

const [latest, ...restEssays] = essays;
const [before, after] = currently.text.split("{bc}");
const lifeRows = life.filter((l) => l.v);
const mail = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<QuietLayout
  bare
  title="Avik Banik"
  metaDescription="Avik Banik, frontend engineer in West Bengal. Five years on VisibleMoney, now building Bardhaman Connect."
>
  <ContourField class="hero" place={site.place} coords={site.coords} timeZone={site.timeZone}>
    <header class="top">
      <a href="/" class="mono home" aria-current="page">{site.domain}</a>
      <nav aria-label="Sections" class="nav">
        <a href="#work">work</a>
        <a href="#building">building</a>
        <a href="#writing">writing</a>
        <a href="#say-hi">say hi</a>
      </nav>
      <span class="bn dhire" lang="bn" title="dheere — slowly">ধীরে</span>
    </header>
    <div class="intro">
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="meta fig">fig. 0 — {site.place}, in contour lines</p>
    </div>
  </ContourField>

  <main id="main">
    <Section label={`Currently · ${currently.month.toLowerCase()}`}>
      <p class="big">{before}<span class="accent">Bardhaman Connect</span>{after}</p>
    </Section>

    <Section id="work" label="Work" note={vm.years}>
      <div class="title">
        <h3>{vm.name}</h3>
        <span class="quote accent">“{vm.quote}”</span>
      </div>
      <p class="body-text">{vm.body}</p>
      <dl class="stats">
        {vm.stats.map((s) => (
          <div>
            <dt class="meta">{s.label}</dt>
            <dd class="mono">{s.n}</dd>
          </div>
        ))}
      </dl>
      <span class="meta">{vm.stack}</span>

      <div class="around">
        <span class="label">Around it</span>
        {vm.around.map((r) => (
          <div class="around-row">
            <span class="meta">{r.year}</span>
            <span class="around-name">{r.name}</span>
            <span class="around-line">{r.line}</span>
            {r.role && <span class="meta around-role">{r.role}</span>}
          </div>
        ))}
      </div>
      <div class="links">
        {vm.links.map((l) => <a href={l.href} rel="noopener" target="_blank">{l.label} ↗</a>)}
      </div>
    </Section>

    <Section id="building" label="Building" note={bc.status}>
      <h3>{bc.name}</h3>
      <p class="body-text">{bc.body}</p>
      <dl class="stats">
        {bc.stats.map((s) => (
          <div>
            <dt class="meta">{s.label}</dt>
            <dd class="mono">{s.n}</dd>
          </div>
        ))}
      </dl>
      <p class="body-text small">{bc.detail}</p>
      <span class="meta">{bc.stack}</span>
    </Section>

    <Section id="writing" label="Writing" note="essays, slowly">
      <div class="writing">
        <a class="latest" href={latest.href}>
          <span class="meta accent">{latest.n} · latest</span>
          <span class="latest-title">{latest.title}</span>
          <span class="latest-dek">{latest.dek}</span>
          <span class="meta">{latest.meta} · read →</span>
        </a>
        <div class="essay-list">
          {restEssays.map((e) =>
            e.href ? (
              <a class="essay" href={e.href}>
                <span class="meta">{e.n}</span>
                <span class="essay-title">{e.title}</span>
                <span class="meta">{e.meta} →</span>
              </a>
            ) : (
              <div class="essay soon">
                <span class="meta">{e.n}</span>
                <span class="essay-title">{e.title}</span>
                <span class="meta">{e.meta}</span>
              </div>
            ),
          )}
        </div>
      </div>
    </Section>

    <Section label="Also made" note="side things, listed honestly">
      <ul class="index">
        {alsoMade.map((m) => (
          <li class="index-row">
            <span class="meta">{m.year}</span>
            <span class="index-name">{m.name}</span>
            <span class="index-line">{m.line}</span>
            <span class:list={["meta", "status", { live: m.status === "alive", ongoing: m.status === "ongoing" }]}>
              {m.status}
            </span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="with" label="With" note="people I've made things with">
      <ul class="kv">
        {people.map((p) => (
          <li>
            <span class="meta">{p.role}</span>
            <span>
              {p.name}
              {p.quote && <q class="pq">{p.quote}</q>}
            </span>
          </li>
        ))}
      </ul>
    </Section>

    {
      lifeRows.length > 0 && (
        <Section id="life" label="Off the clock" note="changes often">
          <ul class="kv">
            {lifeRows.map((l) => (
              <li>
                <span class="meta">{l.k}</span>
                <span>{l.v}</span>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section id="ask" label="Ask me about">
      <div class="asks">
        {asks.map((a) => <a class="ask" href={mail(`About ${a}`)}>{a}</a>)}
      </div>
      <p class="meta">each one opens an email with the subject filled in</p>
    </Section>

    <Section id="declared" label="Declared" note="full transparency">
      <div class:list={["declared", { "has-photo": photo }]}>
        {photo && <img class="photo" src={photo.src} alt={photo.alt} width="96" height="128" loading="lazy" />}
        <dl class="kv">
          {declared.map((d) => (
            <div>
              <dt class="meta">{d.k}</dt>
              <dd>{d.v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <p class="stay">I tend to stay.</p>
    </Section>

    <Section id="say-hi" label="Say hi" note={`replies within ${site.replyWithinDays} days`}>
      <SayHi
        client:visible={{ rootMargin: "400px" }}
        contactEmail={site.email}
        place={site.place}
        timeZone={site.timeZone}
        replyWithinDays={site.replyWithinDays}
      />
    </Section>

    <Section id="book" label="Visitors' book" note="leave a mark ✎" last>
      <VisitorsBook client:visible={{ rootMargin: "400px" }} />
    </Section>
  </main>

  <Footer />
</QuietLayout>

<style>
  :global(.field.hero) {
    min-height: min(100svh, 760px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px var(--pad) 40px;
  }

  @media (min-width: 900px) {
    :global(.field.hero) {
      padding: 32px var(--pad) 72px;
    }
  }

  .top {
    max-width: calc(var(--max) - 2 * var(--pad));
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .home {
    color: var(--muted);
    text-decoration: none;
  }

  .nav {
    display: none;
    gap: 28px;
    margin-left: auto;
    font-family: var(--font-mono);
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .nav {
      display: flex;
    }
  }

  .dhire {
    font-size: 15px;
    color: #b9b6ac;
  }

  .intro {
    max-width: calc(var(--max) - 2 * var(--pad));
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: clamp(46px, 9vw, 104px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .tagline {
    max-width: 22ch;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.35;
    font-weight: 300;
    color: var(--ink-soft);
  }

  .fig {
    margin-top: 8px;
    letter-spacing: 0.04em;
  }

  .big {
    max-width: 36ch;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.4;
    font-weight: 300;
  }

  h3 {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
  }

  .body-text {
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-body);
  }

  @media (min-width: 900px) {
    .body-text {
      font-size: 18px;
    }
  }

  .body-text.small {
    font-size: 15px;
  }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 14px 0;
  }

  .stats dt {
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-variant-numeric: tabular-nums;
  }

  .around {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
  }

  .around .label {
    font-size: 10px;
    padding-bottom: 10px;
  }

  .around-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 4px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .around-name {
    font-size: 16px;
  }

  .around-line,
  .around-role {
    grid-column: 2;
  }

  .around-line {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .around-row {
      grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 2fr) 160px;
      column-gap: 20px;
    }
    .around-line,
    .around-role {
      grid-column: auto;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 14px;
  }

  .writing {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .writing {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 48px;
    }
  }

  .latest {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }

  .latest-title {
    font-family: var(--font-serif);
    font-size: clamp(30px, 3.2vw, 40px);
    line-height: 1.1;
  }

  .latest-dek {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    font-weight: 300;
    color: var(--ink-body);
  }

  .latest:hover .latest-title {
    color: var(--accent);
  }

  .essay-list {
    display: flex;
    flex-direction: column;
  }

  .essay {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    column-gap: 14px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
    text-decoration: none;
  }

  .essay:last-child {
    border-bottom: 1px solid var(--line);
  }

  .essay-title {
    font-family: var(--font-serif);
    font-size: 19px;
  }

  .essay.soon .essay-title {
    color: var(--muted);
  }

  .index,
  .kv {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    column-gap: 12px;
    row-gap: 2px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .index-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .index-name {
    font-size: 16px;
  }

  .index-line {
    grid-column: 2 / 4;
    grid-row: 2;
    font-size: 14px;
    color: var(--muted);
  }

  .status.live {
    color: var(--accent);
  }

  .status.ongoing {
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .index-row {
      grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 2fr) 88px;
      column-gap: 20px;
    }
    .index-line {
      grid-column: auto;
      grid-row: auto;
    }
    .status {
      text-align: right;
    }
  }

  .kv > li,
  .kv > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    column-gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .kv > :last-child {
    border-bottom: 1px solid var(--line);
  }

  .kv dt {
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .kv dd {
    margin: 0;
  }

  @media (min-width: 900px) {
    .kv > li,
    .kv > div {
      grid-template-columns: 210px minmax(0, 1fr);
      column-gap: 20px;
    }
  }

  .pq {
    display: block;
    margin-top: 6px;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-body);
  }

  .asks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ask {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    font-size: 14px;
    color: var(--ink-body);
    text-decoration: none;
  }

  .ask:hover {
    border-color: var(--accent);
  }

  .declared {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .declared.has-photo {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 32px;
      align-items: start;
    }
  }

  .photo {
    width: 96px;
    height: 128px;
    border-radius: 4px;
    border: 1px solid var(--line-strong);
    object-fit: cover;
    filter: grayscale(0.3);
  }

  .stay {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    color: var(--ink-soft);
  }
</style>
