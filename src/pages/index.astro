---
import QuietLayout from "~/layouts/QuietLayout.astro";
import ContourField from "~/components/quiet/ContourField.astro";
import Section from "~/components/quiet/Section.astro";
import Footer from "~/components/quiet/Footer.astro";
import SayHi from "~/components/quiet/SayHi.vue";
import VisitorsBook from "~/components/quiet/VisitorsBook.vue";
import {
  site,
  currently,
  visibleMoney as vm,
  bardhamanConnect as bc,
  sketches,
  toolbox,
  asks,
  declared,
} from "~/data/home";

const [before, after] = currently.text.split("{bc}");
const taglineLines = site.tagline.split(/(?<=\.)\s+/);
const mail = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<QuietLayout
  bare
  title={`${site.name} · ${site.role.toLowerCase()}`}
  metaDescription={`${site.name}, ${site.role.toLowerCase()} in Bardhaman, West Bengal. Frontend by habit, the rest by need, now with AI. On VisibleMoney since 2021.`}
>
  <ContourField class="hero" place={site.place} coords={site.coords} timeZone={site.timeZone}>
    <header class="top">
      <a href="/" class="mono home" aria-current="page">{site.domain}</a>
      <nav aria-label="Sections" class="nav">
        <a href="#work">work</a>
        <a href="#building">building</a>
        <a href="#say-hi">say hi</a>
      </nav>
      <span class="bn dhire" lang="bn" title="dheere — slowly">ধীরে</span>
    </header>
    <div class="intro">
      <p class="kicker">{site.role} · freelance</p>
      <h1>{site.name}</h1>
      <p class="tagline">
        {taglineLines.map((line, i) => <span class:list={["line", { first: i === 0 }]}>{line}</span>)}
      </p>
      <div class="intro-foot">
        {site.availability && (
          <a class="avail" href="#say-hi" data-say-hi><span class="dot" aria-hidden="true"></span>{site.availability} <span aria-hidden="true">→</span></a>
        )}
        <p class="meta fig">fig. 0 — {site.place}, in contour lines</p>
      </div>
    </div>
  </ContourField>

  <main id="main">
    <Section label={`Currently · ${currently.month.toLowerCase()}`}>
      <p class="big">{before}<span class="accent">Bardhaman Connect</span>{after}</p>
    </Section>

    <Section id="work" label="Work" note={vm.years}>
      <div class="title">
        <h3>{vm.name}</h3>
        <span class="quote accent">“{vm.quote}”</span>
      </div>
      <p class="body-text">{vm.body}</p>
      <dl class="stats">
        {vm.stats.map((s) => (
          <div>
            <dt class="meta">{s.label}</dt>
            <dd class="mono">{s.n}</dd>
          </div>
        ))}
      </dl>
      <span class="meta">{vm.stack}</span>

      <div class="around">
        <span class="label">Around it</span>
        {vm.around.map((r) => (
          <div class="around-row">
            <span class="meta">{r.year}</span>
            <span class="around-name">{r.name}</span>
            <span class="around-line">{r.line}</span>
            {r.role && <span class="meta around-role">{r.role}</span>}
          </div>
        ))}
      </div>
      <div class="links">
        {vm.links.map((l) => <a href={l.href} rel="noopener" target="_blank">{l.label} ↗</a>)}
      </div>
    </Section>

    <Section id="building" label="Building" note={bc.status}>
      <h3>{bc.name}</h3>
      <p class="body-text">{bc.body}</p>
      <dl class="stats">
        {bc.stats.map((s) => (
          <div>
            <dt class="meta">{s.label}</dt>
            <dd class="mono">{s.n}</dd>
          </div>
        ))}
      </dl>
      <p class="body-text small">{bc.detail}</p>
      <span class="meta">{bc.stack}</span>
    </Section>

    <Section id="toolbox" label="Toolbox" note="grouped, not ranked">
      <dl class="kv">
        {toolbox.map((t) => (
          <div>
            <dt class="meta">{t.k}</dt>
            <dd>{t.v}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <Section label="Sketches" note="as they are">
      <p class="body-text small">Small things I tried when I had the time. Most are as finished as they'll get.</p>
      <ul class="index">
        {sketches.map((m) => (
          <li class="index-row">
            <span class="meta">{m.year}</span>
            <span class="index-name">{m.name}</span>
            <span class="index-line">{m.line}</span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="ask" label="Ask me about">
      <div class="asks">
        {asks.map((a) => <a class="ask" href={mail(`About ${a}`)}>{a}</a>)}
      </div>
      <p class="meta">each one opens an email with the subject filled in</p>
    </Section>

    <Section id="declared" label="Declared" note="full transparency">
      <div class="declared">
        <dl class="kv">
          {declared.map((d) => (
            <div>
              <dt class="meta">{d.k}</dt>
              <dd>{d.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <Section id="say-hi" label="Say hi" note={`replies within ${site.replyWithinDays} days`}>
      <SayHi
        client:idle
        contactEmail={site.email}
        place={site.place}
        timeZone={site.timeZone}
        replyWithinDays={site.replyWithinDays}
      />
    </Section>

    <Section id="book" label="Visitors' book" note="leave a mark ✎" last>
      <VisitorsBook client:visible={{ rootMargin: "400px" }} />
    </Section>
  </main>

  <!-- Phone-only section links. Shown once the hero is gone, hidden at the footer. -->
  <nav class="dock" aria-label="Jump to" data-dock hidden>
    <a href="#work">work</a>
    <a href="#building">building</a>
    <a href="#say-hi" data-say-hi class="hi"><span class="dot" aria-hidden="true"></span>say hi</a>
  </nav>

  <Footer />
</QuietLayout>

<script>
  const dock = document.querySelector<HTMLElement>("[data-dock]");
  const hero = document.querySelector(".field.hero");
  const foot = document.querySelector("footer");
  if (dock && hero && "IntersectionObserver" in window) {
    dock.hidden = false;
    let pastHero = false;
    let atFoot = false;
    const sync = () => dock.classList.toggle("shown", pastHero && !atFoot);
    new IntersectionObserver(([e]) => ((pastHero = !e.isIntersecting), sync())).observe(hero);
    if (foot) new IntersectionObserver(([e]) => ((atFoot = e.isIntersecting), sync())).observe(foot);
  }
</script>

<style>
  :global(.field.hero) {
    min-height: min(100svh, 760px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px var(--pad) 40px;
  }

  @media (min-width: 900px) {
    :global(.field.hero) {
      padding: 32px var(--pad) 72px;
    }
  }

  .top {
    max-width: calc(var(--max) - 2 * var(--pad));
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .home {
    color: var(--muted);
    text-decoration: none;
  }

  .nav {
    display: none;
    gap: 28px;
    margin-left: auto;
    font-family: var(--font-mono);
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .nav {
      display: flex;
    }
  }

  .dhire {
    font-size: 15px;
    color: #b9b6ac;
  }

  .intro {
    max-width: calc(var(--max) - 2 * var(--pad));
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: clamp(46px, 9vw, 104px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tagline {
    display: flex;
    flex-direction: column;
    max-width: 36ch;
    font-size: clamp(19px, 2.4vw, 28px);
    line-height: 1.35;
    font-weight: 300;
    color: var(--ink-soft);
  }

  .tagline .line {
    text-wrap: balance;
  }

  .tagline .first {
    color: var(--ink);
  }

  .intro-foot {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: rgb(15 16 13 / 0.6);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  .avail:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgb(224 168 69 / 0.5);
    animation: ping 2.4s ease-out infinite;
  }

  @keyframes ping {
    70%,
    100% {
      box-shadow: 0 0 0 7px rgb(224 168 69 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }

  :global(html[data-quiet]) .dot {
    animation: none;
  }

  .fig {
    letter-spacing: 0.04em;
  }

  .big {
    max-width: 36ch;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.4;
    font-weight: 300;
  }

  h3 {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
  }

  .body-text {
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-body);
  }

  @media (min-width: 900px) {
    .body-text {
      font-size: 18px;
    }
  }

  .body-text.small {
    font-size: 15px;
  }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 14px 0;
  }

  .stats dt {
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-variant-numeric: tabular-nums;
  }

  .around {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
  }

  .around .label {
    font-size: 10px;
    padding-bottom: 10px;
  }

  .around-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 4px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .around-name {
    font-size: 16px;
  }

  .around-line,
  .around-role {
    grid-column: 2;
  }

  .around-line {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .around-row {
      grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 2fr) 160px;
      column-gap: 20px;
    }
    .around-line,
    .around-role {
      grid-column: auto;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 14px;
  }

  .index,
  .kv {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 2px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .index-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .index-name {
    font-size: 16px;
  }

  .index-line {
    grid-column: 2;
    grid-row: 2;
    font-size: 14px;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .index-row {
      grid-template-columns: 56px minmax(0, 1fr) minmax(0, 2fr);
      column-gap: 20px;
    }
    .index-line {
      grid-column: auto;
      grid-row: auto;
    }
  }

  .kv > li,
  .kv > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    column-gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .kv > :last-child {
    border-bottom: 1px solid var(--line);
  }

  .kv dt {
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .kv dd {
    margin: 0;
  }

  @media (min-width: 900px) {
    .kv > li,
    .kv > div {
      grid-template-columns: 210px minmax(0, 1fr);
      column-gap: 20px;
    }
  }

  .asks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ask {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    font-size: 14px;
    color: var(--ink-body);
    text-decoration: none;
  }

  .ask:hover {
    border-color: var(--accent);
  }

  .declared {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  /* ---------- phone dock ---------- */
  .dock {
    position: fixed;
    left: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 20;
    display: flex;
    align-items: center;
    padding: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 26px;
    background: rgb(21 22 15 / 0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.45);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 14px);
    transition: opacity 0.25s, transform 0.25s, visibility 0s 0.25s;
  }

  .dock[hidden] {
    display: none;
  }

  .dock.shown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 0.25s, transform 0.25s;
  }

  .dock a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 22px;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .dock a:active {
    background: rgb(236 233 224 / 0.06);
  }

  .dock .hi {
    color: var(--accent);
  }

  .dock .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (min-width: 900px) {
    .dock {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock,
    .dock.shown {
      transition: none;
    }
  }
</style>
