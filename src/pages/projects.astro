---
import MainLayout from "~/layouts/MainLayout.astro";
import { projectsWidget } from "~/data/site-info";

const projectNotes = [
  {
    badge: "Commerce",
    status: "checkout behaved",
    title: "The store that stopped losing the plot",
    quote: "The cart is no longer doing performance art.",
  },
  {
    badge: "Bookings",
    status: "calendar survived",
    title: "Reservations without the spreadsheet panic",
    quote: "We finally know who is coming in at 7.",
  },
  {
    badge: "Portfolio",
    status: "shader contained",
    title: "This site, after several identity crises",
    quote: "The experiments are still here. They just have boundaries now.",
  },
];
---

<MainLayout
  title="Projects"
  metaDescription="Selected projects by Avik Banik across web apps, dashboards, Web3 interfaces, and creative coding."
>
  <section class="projects-section">
    <div class="container">
      <div class="projects-hero">
        <p class="eyebrow">Selected Work</p>
        <h1>Things that shipped and left a paper trail.</h1>
        <p>
          A compact wall of work: real builds, useful interfaces, and the kind
          of technical cleanup that usually sounds boring until it saves the
          week.
        </p>
      </div>

      <div class="projects-grid">
        {
          projectsWidget.projects.map((project, index) => {
            const note = projectNotes[index] ?? {
              badge: "Build",
              status: "shipped",
              title: project.title,
              quote: "It works, which is a strong start.",
            };

            return (
              <article class="project-card">
                <div class="project-meta">
                  <span class="project-tag">{note.badge}</span>
                  <span class="project-date">{note.status}</span>
                </div>

                <h2>{note.title}</h2>
                <p class="original-title">{project.title}</p>
                <p class="project-description">{project.description}</p>
                <blockquote>"{note.quote}"</blockquote>

                {project.tags && (
                  <div class="project-tech">
                    {project.tags.map((tech: string) => (
                      <span class="tech-tag">{tech}</span>
                    ))}
                  </div>
                )}

                <div class="project-links">
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      class="project-link"
                      target="_blank"
                      rel="noopener"
                    >
                      View live
                    </a>
                  )}
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      class="project-link"
                      target="_blank"
                      rel="noopener"
                    >
                      GitHub
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>

      {
        projectsWidget.projects.length === 0 && (
          <div class="projects-empty">
            <p class="eyebrow">Coming Soon</p>
            <p>Case studies are being assembled without pretending the first draft was perfect.</p>
          </div>
        )
      }
    </div>
  </section>
</MainLayout>

<style>
  :global(body) {
    background: #fff7df;
  }

  .projects-section {
    min-height: calc(100vh - 96px);
    padding: 4rem 0 5rem;
    background:
      linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      #fff7df;
    background-size: 28px 28px;
  }

  @media (min-width: 768px) {
    .projects-section {
      padding: 6rem 0;
    }
  }

  .projects-hero {
    max-width: 860px;
    margin-bottom: 3rem;
  }

  .projects-hero h1 {
    max-width: 820px;
    color: #111827;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: 0;
    margin-top: 0.5rem;
  }

  .projects-hero p:not(.eyebrow) {
    max-width: 680px;
    margin-top: 1rem;
    color: #475569;
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background: #ffffff;
    padding: 1.5rem;
    border-radius: 8px;
    border: 2px solid #111827;
    box-shadow: 7px 7px 0 rgba(17, 24, 39, 0.18);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .project-card:nth-child(even) {
    box-shadow: 7px 7px 0 #06b6d4;
  }

  .project-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 #ef4444;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .project-tag,
  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .project-tag {
    padding: 0.25rem 0.75rem;
    background: #fee2e2;
    color: #991b1b;
    border: 2px solid #111827;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-date {
    color: #475569;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .project-card h2 {
    color: #111827;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.08;
    letter-spacing: 0;
    margin-bottom: 0.5rem;
  }

  .original-title {
    color: #ef4444;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-description {
    color: #475569;
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .project-card blockquote {
    margin: 0 0 1.25rem;
    padding: 0.8rem 1rem;
    background: #fff7df;
    border: 2px solid #111827;
    border-radius: 8px;
    color: #111827;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    padding: 0.25rem 0.65rem;
    background: #cffafe;
    color: #111827;
    border: 1px solid #111827;
    border-radius: 999px;
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #111827;
    font-weight: 700;
    text-decoration: none;
  }

  .project-link::after {
    content: "->";
    color: #ef4444;
    font-family: var(--font-mono);
  }

  .projects-empty {
    text-align: center;
    padding: 4rem 2rem;
    background: #ffffff;
    border-radius: 8px;
    border: 2px dashed #111827;
  }

  .projects-empty p {
    margin: 0.5rem 0;
    color: #475569;
    font-size: 1.125rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
