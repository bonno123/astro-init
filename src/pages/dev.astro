---
export const prerender = false  // disable static rendering since app is configured as hybrid

import { db, Comment } from 'astro:db';
import MainLayout from '~/layouts/MainLayout.astro';
import EvenColumnsLayout from '~/layouts/EvenColumnsLayout.astro';
import { heroWidget } from '~/data/site-info';

type Metadata = {
    [key: string]: string;
}

const comments = await db.select().from(Comment);
---
<MainLayout 
	title={heroWidget.title}
	metaDescription={heroWidget.description}
>
	<EvenColumnsLayout>
        <div class="fs-600">
            {
                comments.map(({ id, authorId, content,flagged, likes, metadata, published }) => (
                    <article class="padding-block-400">
                        <p>Comment Id: {id}</p>
                        <p>AuthorId: {authorId}</p>
                        <p>Content: {content}</p>

                        <p>Flagged: {flagged}</p>
                        <p>Likes: {likes}</p>

                        <div class="">
                            <p> Metadata: {
                                Object.keys(metadata as Metadata).map((key) => (
                                    <p class="padding-inline-900">{key}: {(metadata as Metadata)[key as keyof Metadata]}</p>
                                ))
                            }</p>
                        </div>
                        <p>Published: {published}</p>

                        <button data-id={id} aria-label="delete comment">
                            Delete
                        </button>
                    </article>
                ))
            }
        </div>

        <div class="">
            <form  style="display: grid" id="add-comment">
                <label for="author">Author ID</label>
                <input id="author" name="authorID" type="number"/>
              
                <label for="content">Content</label>
                <textarea id="content" name="content"></textarea>
              
                <button class="margin-top-400" type="submit">Submit</button>
              </form>
        </div>
	</EvenColumnsLayout>
</MainLayout>

<script>
const deleteButtons = (document.querySelectorAll("[data-id]")) as NodeListOf<HTMLButtonElement>;
deleteButtons.forEach((button) => {
    button.addEventListener("click", async (event) => {
        const id = button.dataset.id;
        const response = await fetch(`/api/comments/${id}/`, {
            method: "DELETE",
        });

        const json = await response.json();

        console.log({json});            
    });
});

const addNewCommentForm = document.getElementById("add-comment") as HTMLFormElement;
addNewCommentForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(addNewCommentForm);
    const values = Object.fromEntries(formData);

    const response = await fetch("/api/comments/", {
        method: "POST",
        body: JSON.stringify(values),
        headers: {
            "Content-Type": "application/json",
        },
    });

    // console.log({ res: await response.json() });
    const json: { id: string } = await response.json();

    // prefetch(window.location.pathname);

});
</script>





