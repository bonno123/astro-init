---
import MainLayout from "~/layouts/MainLayout.astro";
import { aboutMeWidget } from "~/data/site-info";
import SocialArea from "~/components/SocialArea.astro";
import PatricioGLobe from "~/canvases/patricio-globe.astro";
---

<MainLayout
  title={aboutMeWidget.title}
  metaDescription="About Avik Banik, a full-stack developer from Kolkata building web apps, dashboards, Web3 interfaces, and creative experiments."
>
  <section class="about-hero">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <p class="eyebrow">Lore</p>
          <h1>Full-stack dev from Kolkata. Calm in meetings, suspicious near deadline math.</h1>

          <div class="about-text">
            <p>
              I build web apps, dashboards, Web3 interfaces, and small
              experiments that occasionally become useful. The work usually sits
              somewhere between product UI, frontend systems, deployment, and
              the part where someone says, "can we make this less confusing?"
            </p>

            <p>
              My default mode is practical: understand the messy thing, shape it
              into something shippable, then keep the implementation boring
              enough that future Avik does not need revenge.
            </p>
          </div>

          <div class="about-stats" aria-label="Avik status">
            <div class="stat">
              <div class="stat-value">30+</div>
              <div class="stat-label">things shipped</div>
            </div>
            <div class="stat">
              <div class="stat-value">Kolkata</div>
              <div class="stat-label">base camp</div>
            </div>
            <div class="stat">
              <div class="stat-value">critical</div>
              <div class="stat-label">chai level</div>
            </div>
          </div>

          <div class="about-cta">
            <a href="/contact/" class="btn btn-primary">Send the problem</a>
            <a href="/projects/" class="btn btn-ghost">See shipped things</a>
          </div>
        </div>

        <div class="about-visual">
          <div class="globe-wrapper">
            <PatricioGLobe />
          </div>
          <p class="visual-note">
            Shader experiments live in the lab. The serious work still has to
            load fast.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="timeline-section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Timeline</p>
        <h2>How the current operating system happened</h2>
      </div>

      <div class="timeline-list">
        <article class="timeline-card">
          <span class="timeline-badge">Survived</span>
          <h3>Started with websites that had to actually convert</h3>
          <p>
            Performance, responsive layouts, client requirements, and the quiet
            realization that "simple page" rarely means simple.
          </p>
        </article>

        <article class="timeline-card">
          <span class="timeline-badge">Humbling</span>
          <h3>Went deeper into apps, dashboards, and state</h3>
          <p>
            Built interfaces where users come back every day, which means the
            rough edges stop being cute very quickly.
          </p>
        </article>

        <article class="timeline-card">
          <span class="timeline-badge">Bold move</span>
          <h3>Added Web3 and wallet flows to the toolbox</h3>
          <p>
            Learned that a connect button can contain more drama than an entire
            landing page.
          </p>
        </article>

        <article class="timeline-card">
          <span class="timeline-badge">Still useful</span>
          <h3>Kept the creative coding experiments</h3>
          <p>
            Shaders, WebGL, and odd prototypes stay in the mix because taste and
            curiosity make the practical work sharper.
          </p>
        </article>
      </div>

      <div class="about-socials">
        <h2>Elsewhere on the internet</h2>
        <SocialArea socials={aboutMeWidget.socialLinks} />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :global(body) {
    background: #fff7df;
  }

  .about-hero,
  .timeline-section {
    background:
      linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      #fff7df;
    background-size: 28px 28px;
  }

  .about-hero {
    padding: 4rem 0;
  }

  .timeline-section {
    padding: 2rem 0 5rem;
  }

  @media (min-width: 768px) {
    .about-hero {
      padding: 6rem 0 4rem;
    }

    .timeline-section {
      padding: 3rem 0 6rem;
    }
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: 4rem;
    align-items: center;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-content h1,
  .section-header h2 {
    color: #111827;
    letter-spacing: 0;
  }

  .about-content h1 {
    max-width: 860px;
    font-size: clamp(2.4rem, 5.5vw, 4.7rem);
    line-height: 0.98;
  }

  .about-text {
    display: grid;
    gap: 1rem;
    max-width: 760px;
  }

  .about-text p,
  .visual-note,
  .timeline-card p {
    color: #475569;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 2px solid #111827;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 8px 8px 0 #111827;
    overflow: hidden;
  }

  .stat {
    padding: 1rem;
    border-right: 2px solid #111827;
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 700;
    color: #ef4444;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.72rem;
    color: #475569;
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .about-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .about-visual {
    position: relative;
  }

  .globe-wrapper {
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #111827;
    border: 3px solid #111827;
    box-shadow: 12px 12px 0 #06b6d4;
  }

  .visual-note {
    margin-top: 1.25rem;
    padding: 1rem;
    background: #ffffff;
    border: 2px solid #111827;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .section-header {
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .timeline-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: #ffffff;
    border: 2px solid #111827;
    border-radius: 8px;
    box-shadow: 6px 6px 0 rgba(17, 24, 39, 0.18);
  }

  .timeline-badge {
    width: max-content;
    padding: 0.25rem 0.65rem;
    background: #facc15;
    color: #111827;
    border: 2px solid #111827;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .timeline-card h3 {
    color: #111827;
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  .timeline-card p {
    font-size: 0.95rem;
  }

  .about-socials {
    margin-top: 3rem;
    padding: 1.5rem;
    background: #111827;
    color: #f8fafc;
    border: 3px solid #111827;
    border-radius: 8px;
    box-shadow: 8px 8px 0 #ef4444;
  }

  .about-socials h2 {
    color: #f8fafc;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .btn {
    border: 2px solid #111827;
    box-shadow: 4px 4px 0 #111827;
  }

  .btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 6px 6px 0 #111827;
  }

  .btn-primary {
    background: #ef4444;
    color: #ffffff;
  }

  .btn-ghost {
    background: #ffffff;
    color: #111827;
  }

  .btn-ghost:hover {
    border-color: #111827;
    color: #111827;
  }

  @media (max-width: 1020px) {
    .about-grid,
    .timeline-list {
      grid-template-columns: 1fr;
    }

    .globe-wrapper {
      max-width: 560px;
    }
  }

  @media (max-width: 768px) {
    .about-stats {
      grid-template-columns: 1fr;
      box-shadow: 6px 6px 0 #111827;
    }

    .stat {
      border-right: 0;
      border-bottom: 2px solid #111827;
    }

    .stat:last-child {
      border-bottom: 0;
    }

    .about-cta {
      flex-direction: column;
    }

    .about-cta .btn {
      width: 100%;
    }
  }
</style>
