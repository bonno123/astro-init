---
import MainLayout from "~/layouts/MainLayout.astro";
import { contactWidget } from "~/data/site-info";
import ContactForm from "~/components/vue-components/ContactForm.vue";
---

<MainLayout
  title={contactWidget.title}
  metaDescription="Contact Avik Banik for web apps, dashboards, Web3 interfaces, technical cleanup, and useful experiments."
>
  <section class="contact-section">
    <div class="container">
      <div class="contact-hero">
        <p class="eyebrow">Contact</p>
        <h1>Send the problem.</h1>
        <p class="contact-subtitle">
          Tell me what you are building, what is broken, or what needs to exist
          before Friday. Clear context beats mysterious calendar invites.
        </p>
      </div>

      <div class="contact-content">
        <div class="contact-form-wrapper">
          <div class="panel-label">
            <span>intake.form</span>
            <span>open</span>
          </div>
          <h2>Start a thread or book a call</h2>
          <ContactForm client:load />
        </div>

        <aside class="contact-info">
          <div class="info-header">
            <p class="eyebrow">Useful context</p>
            <h2>What helps me reply properly</h2>
          </div>

          <div class="info-item">
            <h3>What are we making?</h3>
            <p>App, dashboard, Web3 flow, cleanup job, experiment, or something stranger.</p>
          </div>

          <div class="info-item">
            <h3>What is the deadline?</h3>
            <p>"Soon" is valid emotionally, but dates are better for planning.</p>
          </div>

          <div class="info-item">
            <h3>Where is the mess?</h3>
            <p>Repo, design, broken flow, performance issue, vague scope, or all of the above.</p>
          </div>

          <div class="info-item">
            <h3>Email</h3>
            <p>
              <a
                href={`mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`}
                class="contact-link"
              >
                {import.meta.env.PUBLIC_CONTACT_EMAIL}
              </a>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :global(body) {
    background: #fff7df;
  }

  .contact-section {
    min-height: calc(100vh - 96px);
    padding: 4rem 0 5rem;
    background:
      linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      #fff7df;
    background-size: 28px 28px;
  }

  @media (min-width: 768px) {
    .contact-section {
      padding: 6rem 0;
    }
  }

  .contact-hero {
    max-width: 860px;
    margin-bottom: 3rem;
  }

  .contact-hero h1 {
    color: #111827;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    line-height: 0.95;
    margin-top: 0.5rem;
    letter-spacing: 0;
  }

  .contact-subtitle {
    font-size: 1.15rem;
    color: #475569;
    max-width: 680px;
    margin-top: 1rem;
    line-height: 1.65;
  }

  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: 1.5rem;
    align-items: start;
  }

  .contact-form-wrapper,
  .contact-info {
    background: #ffffff;
    border-radius: 8px;
    border: 2px solid #111827;
  }

  .contact-form-wrapper {
    padding: 1.5rem;
    box-shadow: 8px 8px 0 #111827;
  }

  .panel-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: -1.5rem -1.5rem 1.5rem;
    padding: 0.85rem 1rem;
    background: #06b6d4;
    color: #111827;
    border-bottom: 2px solid #111827;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .contact-form-wrapper h2 {
    color: #111827;
    font-size: clamp(1.45rem, 3vw, 2rem);
    margin-bottom: 1.5rem;
    letter-spacing: 0;
  }

  .contact-info {
    padding: 1.25rem;
    box-shadow: 8px 8px 0 #ef4444;
  }

  .info-header {
    margin-bottom: 1.5rem;
  }

  .info-header h2 {
    color: #111827;
    font-size: 1.35rem;
    margin-top: 0.35rem;
    letter-spacing: 0;
  }

  .info-item {
    padding: 1rem 0;
    border-top: 2px solid #111827;
  }

  .info-item h3 {
    font-size: 0.8rem;
    color: #ef4444;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .info-item p {
    color: #475569;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .contact-link {
    color: #111827;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid #06b6d4;
  }

  .contact-link:hover {
    border-bottom-color: #ef4444;
  }

  @media (max-width: 900px) {
    .contact-content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .contact-form-wrapper,
    .contact-info {
      box-shadow: 6px 6px 0 #111827;
    }
  }
</style>
