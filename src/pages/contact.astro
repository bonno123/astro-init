---
import MainLayout from "~/layouts/MainLayout.astro";
import { contactWidget } from "~/data/site-info";
import ContactForm from "~/components/vue-components/ContactForm.vue";
---

<MainLayout
  title={contactWidget.title}
  metaDescription={contactWidget.description}
>
  <section class="contact-section">
    <div class="container">
      <!-- Hero Section -->
      <div class="contact-hero">
        <p class="eyebrow">Let's Talk</p>
        <h1>Get in Touch</h1>
        <p class="contact-subtitle">
          Have a project in mind? Let's discuss your goals and how we can help
          bring your vision to life.
        </p>
      </div>

      <!-- Contact Form -->
      <div class="contact-content">
        <div class="contact-form-wrapper">
          <h2>Send us a message</h2>
          <ContactForm client:load />
        </div>

        <!-- Contact Info -->
        <div class="contact-info">
          <h2>Other ways to reach us</h2>

          <div class="info-item">
            <h3>Email</h3>
            <p>
              <a
                href={`mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`}
                class="contact-link"
              >
                {import.meta.env.PUBLIC_CONTACT_EMAIL}
              </a>
            </p>
          </div>

          <div class="info-item">
            <h3>Location</h3>
            <p>Available for remote projects worldwide</p>
          </div>

          <div class="info-item">
            <h3>Response Time</h3>
            <p>We typically respond within 24 hours</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .contact-section {
    padding: 4rem 0;
    background: var(--color-off-white);
  }

  @media (min-width: 768px) {
    .contact-section {
      padding: 6rem 0;
    }
  }

  .contact-hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contact-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin-top: 0.5rem;
    color: var(--color-navy);
  }

  .contact-subtitle {
    font-size: 1.125rem;
    color: var(--color-slate-600);
    max-width: 600px;
    margin: 1rem auto 0;
    line-height: 1.6;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    margin-top: 3rem;
  }

  .contact-form-wrapper {
    background: var(--color-white);
    padding: 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .contact-form-wrapper h2 {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
  }

  .contact-info {
    background: var(--color-white);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(15, 23, 42, 0.08);
    height: max-content;
  }

  .contact-info h2 {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }

  .info-item {
    margin-bottom: 1.25rem;
  }

  .info-item:last-child {
    margin-bottom: 0;
  }

  .info-item h3 {
    font-size: 0.875rem;
    color: var(--color-cyan);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .info-item p {
    color: var(--color-slate-600);
    line-height: 1.5;
    font-size: 0.9375rem;
  }

  .contact-link {
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: none;
    transition: color 250ms ease;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
  }

  .contact-link:hover {
    color: var(--color-cyan);
    border-bottom-color: var(--color-cyan);
  }

  @media (max-width: 768px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .contact-form-wrapper,
    .contact-info {
      padding: 1.5rem;
    }
  }
</style>

<style>
  .contact-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .booking-section {
    margin: 3rem 0;
  }

  .contact-info {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--clr-border);
  }

  .contact-info h3 {
    font-size: 1.25rem;
    color: var(--clr-primary);
    margin-bottom: 1rem;
  }

  .contact-info p {
    margin-bottom: 0.75rem;
    color: var(--clr-contrast-medium);
  }

  .contact-info a {
    color: var(--clr-accent);
    text-decoration: none;
  }

  .contact-info a:hover {
    text-decoration: underline;
  }

  @media (max-width: 55em) {
    .contact-container {
      padding: 1.5rem 1rem;
    }

    .booking-section {
      margin: 2rem 0;
    }
  }
</style>
