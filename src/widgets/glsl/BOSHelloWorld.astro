---
import EvenColumnsLayout from '~/layouts/EvenColumnsLayout.astro';
import fragmentShader from "~/glsl/bos-hello-world/hello.frag?raw";
import Link from '~/components/common/Link.astro';

---

<EvenColumnsLayout>
    <div class="">
        <canvas
            class="glslCanvas"
            id="BOSHelloWorldCanvas"
            data-fragment={fragmentShader}

        >
            Your browser does not support the HTML5 canvas element.
        </canvas>    
    </div>

    <div class="flow">
        <div class="">
            <h1 class="fs-secondary-heading fw-bold">Hello world!</h1>
            <p data-width="wide" class="margin-top-400">
                this is a simple example of a fragment shader that renders a gradient.
            </p>
        </div>

        <p>
            @following
            <Link
                label=' example 02'
                href={`https://thebookofshaders.com/02/`}
            />
            from The Book of Shaders
        </p>
        
        <div class=""></div>
    </div>

</EvenColumnsLayout>

<script>
import GlslCanvas from 'glslCanvas';
// import fragmentShader from "~/glsl/bos-hello-world/hello.frag?raw";

// Assuming 'canvas' is your GLSL canvas element
const adjustCanvasForDPR = (canvas: HTMLCanvasElement | null) => {
if (!canvas) return;

const dpr = window.devicePixelRatio || 1;
const rect = canvas.getBoundingClientRect();
canvas.width = rect.width * dpr;
canvas.height = rect.height * dpr;
canvas.style.width = `${rect.width}px`;
canvas.style.height = `${rect.height}px`;
const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
if (gl) {
    // Adjust the viewport of the GL context to match the new size
    (gl as WebGLRenderingContext).viewport(0, 0, canvas.width, canvas.height);
}
};

// // Call this function when the page loads and when it resizes
// window.addEventListener('load', () => adjustCanvasForDPR(document.querySelector('.glslCanvas')));
// window.addEventListener('resize', () => adjustCanvasForDPR(document.getElementById('BOSHelloWorldCanvas') as HTMLCanvasElement));

// document.addEventListener('DOMContentLoaded', reInitializeCanvas);
document.addEventListener('astro:page-load', reInitializeCanvas);

function reInitializeCanvas(ev: Event) {
    const canvas = document.getElementById('BOSHelloWorldCanvas') as HTMLCanvasElement;
    var sandbox = new GlslCanvas(canvas);
    // sandbox.load(fragmentShader);

    adjustCanvasForDPR(canvas);
}
</script>
    
    
<style>
    @import url('src/styles/glsl-canvas.scss');
</style>