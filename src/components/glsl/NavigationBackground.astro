---
import background from "~/glsl/navigation-bg/background.frag?raw";

type Props = {
  class?: string;
  containerClass?: string;
};

const {
  class: providerClass,
  containerClass,
} = Astro.props;

---

<!-- Wrap the component elements in our custom element “astro-heart”. -->
<div class:list={[containerClass, 'canvas-container']}>
  <canvas
    class:list={[providerClass, 'glslCanvas']}
    data-fragment={background}
  >
    Your browser does not support the HTML5 canvas element.
  </canvas>
</div>

<script>
  import GlslCanvas from 'glslCanvas';

  // While canvas is loading, hide it with opacity and show it once the shader is loaded
    const canvasElement = document.querySelector('.glslCanvas') as HTMLCanvasElement;
    if (canvasElement) {
      // Initialize GlslCanvas
      const sandbox = new GlslCanvas(canvasElement);
      sandbox.load(canvasElement.dataset.fragment);
      // Check if the shader is loaded
      sandbox.on('render', () => {
        // Once the shader is loaded, make the canvas visible
        canvasElement.style.opacity = '1';
      });
    }

</script>
      
      
<style>
  /* @import url('src/styles/glsl-canvas.scss'); */

  .glslCanvas {
    opacity: 0; /* Initially hide the canvas */
    transition: opacity 0.5s ease-out; /* Smooth transition to visible */
  }
</style>



<style>
  .canvas-container {
    /* position: absolute; */
    width: 100%;
    background-color: #e5e5e5;

    z-index: -1;
  }


</style>

<style is:global>

.canvas-container.collapsed {
  height: 0;
  width: 0;
  transition: height 0.5s, width 0.5s;
  overflow: hidden;
}

</style>