<!-- Wrap the component elements in our custom element “astro-heart”. -->
<glsl-canvas-background>
  <button aria-label="Heart">💜</button> × <span>0</span>
</glsl-canvas-background>

<script>
import GlslCanvas from 'glslCanvas'; // Import the necessary library or module

class GlslCanvasBackground extends HTMLElement {
  private glslCanvas: any;
  private canvas: HTMLCanvasElement | null = null;

  connectedCallback() {
    this.canvas = document.createElement('canvas');
    this.appendChild(this.canvas);

    this.glslCanvas = new GlslCanvas(this.canvas);
    this.glslCanvas.load(`
      void main() {
        gl_FragColor = vec4(0.2, 0.4, 0.0, 1.0);
      }
    `);
  }

  disconnectedCallback() {
    this.glslCanvas.destroy();
  }
}

customElements.define('glsl-canvas-background', GlslCanvasBackground);
</script>

<style>
  glsl-canvas-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }


</style>