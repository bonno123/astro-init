---
import { decorateTextLinks } from '~/utils/decorateTextLinks';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

---

<div class="flow reversed">
  <h1 class="fs-primary-heading fw-bold">
    {title}
  </h1>

  <p 
    data-width="wide"
    set:html={decorateTextLinks(description)}
  />

  <div class=""></div>
</div>

<style>
@media (max-width: 55em) {
  .reversed {
      grid-row-start: 2;
    }
}
</style>

<style is:global>
/* component */
.text-bg-effect {
  background-repeat: no-repeat;
  will-change: background-size;
  transition: background-size 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);
}
.text-bg-effect:hover {
  background-size: 100% 100%;
}

/* .text-bg-effect--scale-x {
  padding: var(--tm7-space-4xs) 0;
  background-image: linear-gradient(hsla(var(--clr-accent), 0.2), hsla(var(--clr-accent), 0.2));
  background-size: 0% 100%;
} */

.text-bg-effect--scale-y {
  text-decoration: none;
  background-image: linear-gradient(var(--clr-accent-transparent) 60%, var(--clr-accent-light));
  background-size: 100% 2px;
  background-position: center bottom;
}
</style>