<script>
  import { navigate } from "astro:transitions/client";

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  function toggleMobileMenu() {
    mobileMenu?.classList.toggle("mobile-menu--open");
    mobileMenuBtn?.classList.toggle("mobile-menu-btn--open");
    document.body.classList.toggle("menu-open");
  }

  mobileMenuBtn?.addEventListener("click", toggleMobileMenu);

  // Close menu when clicking outside
  mobileMenu?.addEventListener("click", (e) => {
    if (e.target === mobileMenu) {
      toggleMobileMenu();
    }
  });

  // Navigate to the selected route when clicking on the button
  document.addEventListener("click", (event) => {
    const button = (event.target as Element)?.closest("[data-route-to]");
    if (!button) return;

    const route = button.getAttribute("data-route-to");

    // Close mobile menu if it's a mobile nav item
    if (button.getAttribute("data-mobile-nav")) {
      toggleMobileMenu();
    }

    navigate(String(route));
  });

  var customEventRouteChanged = new CustomEvent("route-changed");

  // since the state is set to persist, we need to update the morph-bg-active attribute when the route changes
  document.addEventListener(
    "astro:page-load",
    (event) => {
      setupStuff(event.target as Element); // This runs once the page is loaded.
    },
    { passive: true },
  );

  function setupStuff(target: Element | null) {
    //  change the attribute data-morph-bg-active to true if the pathname matches the button's data-route-to
    // Assuming `pathname` is reactive and part of your component's state
    let routePath = window.location.pathname; // Initialize pathname with the current path
    const buttons = target?.querySelectorAll("[data-route-to]");

    if (!buttons) return;

    buttons.forEach((button) => {
      const routeTo = button.getAttribute("data-route-to");
      button.setAttribute(
        "data-morph-bg-active",
        String(routeTo === routePath),
      );
    });

    doneRouteChange(customEventRouteChanged);
  }

  function doneRouteChange(customEvent: CustomEvent<unknown>) {
    window.dispatchEvent(customEvent);
  }
</script>

<script>
  import MorphBackground from "~/utils/morphBackgroundClass";

  var morphBg = document.getElementsByClassName("js-morph-bg");

  function initMorph() {
    if (morphBg.length > 0) {
      for (var i = 0; i < morphBg.length; i++) {
        const morphInstance = new MorphBackground(morphBg[i] as HTMLElement);
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const targetElement = document.querySelector(".demo-morph-bg-button"); // Adjust the selector as needed

    const observer = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Element is now visible
            initMorph();
            // Optionally, stop observing if you only need to initialize once
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null, // observing the document viewport
        rootMargin: "0px",
        threshold: 0.1, // Adjust threshold to control when the callback is executed
      },
    );

    // Start observing the target element
    observer.observe(targetElement!);
  });

  // ============== MORPH BG RESIZE ============== //
  // on window resize - reset morph bg size
  var resizingId: string | number | undefined,
    customEventMorph = new CustomEvent("update-morphbg"),
    customEventHide = new CustomEvent("hide-morphbg");

  // on window resize - reset morph bg size
  window.addEventListener("resize", function () {
    if (!resizingId) doneResizing(customEventHide);
    clearTimeout(resizingId as number);
    resizingId = setTimeout(function () {
      doneResizing(customEventMorph);
      resizingId = undefined;
    }, 100) as unknown as number;
  });

  // wait for font to be loaded
  if (document.fonts) {
    document.fonts.onloadingdone = function (fontFaceSetEvent) {
      doneResizing(customEventMorph);
    };

    document.fonts.ready.then(function () {
      setTimeout(function () {
        doneResizing(customEventMorph);
      }, 300);
    });
  }

  function doneResizing(customEvent: CustomEvent<unknown>) {
    window.dispatchEvent(customEvent);
  }
</script>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }
</style>

<style>
  /* -------------------------------- 

Title: Morphing Background
Descr: A morphing background item that transitions from one element's position to another's

-------------------------------- */

  /* --------------------------------

Component 

-------------------------------- */

  .morph-bg {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 1px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    transform-origin: left top;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .morph-bg--visible {
    opacity: 1;
  }

  .morph-bg--has-transition {
    transition: 0.3s;
    will-change: transform, border-radius, height, width;
  }

  /* -------------------------------- 

Demo style 

-------------------------------- */

  .demo-morph-bg-paragraph {
    position: relative; /* This makes z-index applicable */
    padding: 1rem;
    font-size: 0.9375rem;
    color: hsl(240, 66%, 63%);
  }

  .demo-morph-bg-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    overflow: hidden;
    padding: 0.5rem;
    background: #ffffff;
    border-radius: 8px;
    border: 2px solid #111827;
    box-shadow: 4px 4px 0 #111827;
    backdrop-filter: blur(12px);
  }

  .demo-morph-bg-link {
    display: block;
    padding: 0.75rem 1rem;
    color: #0f172a;
    text-decoration: none;
    font-weight: 600;
  }

  .demo-morph-bg-target {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
  }

  .demo-morph-bg-button {
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    color: #111827;
    padding: 0.625rem 1rem;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    background: transparent;
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
  }

  .nav-icon {
    display: none;
  }

  .nav-label {
    font-size: 0.9375rem;
  }

  .demo-morph-bg-button:hover {
    color: #111827;
    background: #fff7df;
    border-color: #111827;
  }

  .demo-morph-bg-button[data-morph-bg-active="true"] {
    color: #111827;
    font-weight: 700;
    background: #cffafe;
    border-color: #111827;
  }

  @keyframes blur {
    0% {
      filter: blur(0);
      transform: scale(1);
    }
    50% {
      filter: blur(1.15px);
      transform: scale(1.02);
    }
    100% {
      filter: blur(0);
      transform: scale(1.01);
      /* background: #2ecc71; */
    }
  }

  /* .demo-morph-bg-1 {
    background-color: hsl(250, 84%, 54%);
} */

  .demo-morph-bg-2 {
    background: #cffafe;
    border-radius: 8px;
    border: 2px solid #111827;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    justify-content: flex-end;
  }

  .github-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 2px solid #111827;
    background: #ffffff;
    color: #111827;
    box-shadow: 4px 4px 0 #111827;
    transition: all 0.2s ease;
  }

  .github-icon-link:hover {
    color: #111827;
    border-color: #111827;
    background: #facc15;
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 #111827;
  }

  .desktop-nav {
    display: flex;
  }

  /* Mobile Menu Button Styles */
  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 2px solid #111827;
    background: #ffffff;
    color: #111827;
    box-shadow: 4px 4px 0 #111827;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    z-index: 10;
  }

  .mobile-menu-btn:hover {
    border-color: #111827;
    color: #111827;
    background: #cffafe;
  }

  .menu-line {
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .mobile-menu-btn--open .menu-line-1 {
    transform: rotate(45deg) translateY(6px);
  }

  .mobile-menu-btn--open .menu-line-2 {
    opacity: 0;
  }

  .mobile-menu-btn--open .menu-line-3 {
    transform: rotate(-45deg) translateY(-6px);
  }

  @media (max-width: 55em) {
    .nav-bar {
      gap: 0.5rem;
      justify-content: space-between;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }

    .github-icon-link {
      width: 44px;
      height: 44px;
    }
  }

  /* Mobile Menu Overlay */

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(8px);
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (max-width: 55em) {
    .mobile-menu {
      display: flex;
      pointer-events: none;
    }

    .mobile-menu--open {
      opacity: 1;
      pointer-events: all;
    }
  }

  .mobile-menu-content {
    position: relative;
    width: min(90%, 360px);
    max-height: 85vh;
    overflow-y: auto;
    background: #fff7df;
    backdrop-filter: blur(20px);
    border-radius: 8px;
    padding: 2rem 1.5rem;
    border: 3px solid #111827;
    box-shadow: 10px 10px 0 #111827;
    transform: scale(0.94);
    transition: transform 0.3s ease;
  }

  .mobile-menu--open .mobile-menu-content {
    transform: scale(1);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    border: 2px solid #111827;
    background: #ffffff;
    color: #111827;
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: var(--font-display);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mobile-nav-item:hover {
    background: #cffafe;
    border-color: #111827;
    color: #111827;
  }

  .mobile-nav-item[aria-current="page"] {
