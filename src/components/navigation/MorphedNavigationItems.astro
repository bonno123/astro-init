    border-color: #111827;
    color: #111827;
    font-weight: 700;
  }

  .mobile-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .mobile-nav-label {
    flex: 1;
    text-align: left;
  }

  @media (min-width: 55.01em) {
    .mobile-menu-btn {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  /* -------------------------------- 

Utilities 

-------------------------------- */

  .cd-block {
    display: block;
  }

  .cd-position-relative {
    position: relative;
  }

  .cd-z-index-1 {
    z-index: 1;
  }

  .cd-z-index-2 {
    z-index: 2;
  }

  /* .cd-margin-y-xs {
    margin-block: 1.675rem;
} */

  /* .cd-margin-bottom-sm {
    margin-bottom: 2.5rem;
} */

  /* .cd-margin-bottom-xl {
    margin-bottom: 4.5rem;
} */

  .cd-text-center {
    text-align: center;
  }

  .github-icon-link {
    display: inline-flex;
    align-items: center;
    margin-left: 1rem;
