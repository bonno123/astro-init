<section class="cd-text-center cd-position-relative">
    <NavigationBackground class=''/>  

    <div class="navigation-content">
      <p class="demo-morph-bg-paragraph ">Click effect ↓</p>
      <div class="cd-position-relative js-morph-bg-wrapper">
        <ul class="demo-morph-bg-list" role="menu">
            <li class="cd-z-index-2 " >
              <a >
                <button
                  data-route-to="/"
                  class="demo-morph-bg-button" 
                  data-morph-bg="morph-bg-2"
                  data-morph-bg-active={pathname === '/'}
                >
                  Home
                </button>
              </a>
            </li>

            <li class="cd-z-index-2">
                <button 
                  data-route-to="/playground/"
                  class="demo-morph-bg-button" 
                  data-morph-bg="morph-bg-2"
                  data-morph-bg-active={pathname === '/playground/'}
                > Playground
                </button>
            </li>

            <li class="cd-z-index-2">
                <button 
                data-route-to="/about/"
                class="demo-morph-bg-button" 
                data-morph-bg="morph-bg-2"
                data-morph-bg-active={ pathname === '/about/' }
                >About</button>
            </li>

            <li class="cd-z-index-2">
                <button
                  data-route-to="/contact/"
                  class="demo-morph-bg-button" 
                  data-morph-bg="morph-bg-2" 
                  data-morph-bg-active={ pathname === '/contact/' }
                >Contact us
                </button>
            </li>
        </ul>

        <span class="morph-bg cd-z-index-1 demo-morph-bg-2 js-morph-bg" id="morph-bg-2" aria-hidden="true"></span>
      </div>
    </div>
</section>

<script>
import { navigate } from 'astro:transitions/client';

// Navigate to the selected route when clicking on the button
document.addEventListener('click', (event) => {
  const button = (event.target as Element)?.closest('[data-route-to]');
  if (!button) return;

  const route = button.getAttribute('data-route-to');
  navigate(String(route));
});
  var customEventRouteChanged = new CustomEvent('route-changed');

// since the state is set to persist, we need to update the morph-bg-active attribute when the route changes
document.addEventListener('astro:page-load', (event) => {
  // This runs once the page is loaded. 
  setupStuff(event.target as Element);
}, { passive: true });

function setupStuff(target: Element | null) {
  //  change the attribute data-morph-bg-active to true if the pathname matches the button's data-route-to
  // Assuming `pathname` is reactive and part of your component's state
  let routePath = window.location.pathname; // Initialize pathname with the current path
  const buttons = target?.querySelectorAll('[data-route-to]');

  if (!buttons) return;

  buttons.forEach((button) => {
    const routeTo = button.getAttribute('data-route-to');
    button.setAttribute('data-morph-bg-active', String(routeTo === routePath));
  });

  doneRouteChange(customEventRouteChanged);
}
function doneRouteChange(customEvent: CustomEvent<unknown>) {
    window.dispatchEvent(customEvent);
  };


</script>

<!-- Styles -->

<style>

.navigation-content {
  position: absolute;
  width: 100%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);

  /* padding: 1rem; */
}

  /* -------------------------------- 
  
  Title: Morphing Background
  Descr: A morphing background item that transitions from one element's position to another's
  
  -------------------------------- */
  
  /* --------------------------------
  
  Component 
  
  -------------------------------- */
  
  .morph-bg {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 1px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    transform-origin: left top;
    -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
  }
  
  .morph-bg--visible {
    opacity: 1;
  }
  
  .morph-bg--has-transition {
    transition: 0.3s;
    will-change: transform, border-radius, height, width;
  }
  
  /* -------------------------------- 
  
  Demo style 
  
  -------------------------------- */
  
  .demo-morph-bg-paragraph {
    padding: 1rem;
    font-size: 0.9375rem;
    color: hsl(240, 4%, 65%);
  }
  
  .demo-morph-bg-list {
    display: inline-flex;
    flex-wrap: wrap;
  }
  
  .demo-morph-bg-link {
    display: block;
    padding: 0.75rem 1rem;
    color: hsl(230, 13%, 9%);
    text-decoration: none;
    font-weight: medium;
  }
  
  .demo-morph-bg-target {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
  }
  
  .demo-morph-bg-button {
    border-radius: 50em;
    font-weight: medium;
    cursor: pointer;
    color: hsl(230, 13%, 9%);
    padding: 0.75rem 1rem;
  }
  
  /* .demo-morph-bg-1 {
    background-color: hsl(250, 84%, 54%);
  } */
  
  .demo-morph-bg-2 {
    background-color: hsla(0, 0%, 8%, 0.438);
  }
  
  /* -------------------------------- 
  
  Utilities 
  
  -------------------------------- */
  
  .cd-block {
    display: block;
  }
  
  .cd-position-relative {
    position: relative;
  }
  
  .cd-z-index-1 {
    z-index: 1;
  }
  
  .cd-z-index-2 {
    z-index: 2;
  }

