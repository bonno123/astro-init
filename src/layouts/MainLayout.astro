---
import BaseHead from "~/components/common/BaseHead.astro";
import MorphedNavigationItems from "~/components/navigation/MorphedNavigationItems.astro";
import LOGO from "~/assets/Logo.astro";
import ChatButton from "~/components/vue-components/ChatButton.vue";

interface Props {
  title: string;
  /**
   * to be concantinated with the default meta description
   */
  metaDescription?: string;
}

const { title: layoutTitle, metaDescription } = Astro.props;
const { pathname } = Astro.url;
const isHome = pathname === "/";
---

<!doctype html>
<html lang="en">
  <BaseHead title={layoutTitle} metaDescription={metaDescription} />

  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-content">
          <a
            href="/"
            class="logo-link"
            aria-label="Go to homepage"
            aria-current={isHome ? "page" : undefined}
            data-home={isHome}
          >
            <span class="sr-only">avik banik logo</span>
            <LOGO height={48} width={48} isHome={isHome} />
          </a>

          <nav transition:persist="">
            <MorphedNavigationItems />
          </nav>
        </div>
      </div>
    </header>

    <main transition:animate="none" id="main-content">
      <slot />
    </main>

    <ChatButton client:load transition:persist />
  </body>
</html>

<style is:global>
  /* Base Layout */
  body {
    margin: 0;
    padding: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<!-- Header Styles -->
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    isolation: isolate;
  }

  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(248, 250, 252, 0.85);
    backdrop-filter: blur(12px);
    z-index: -1;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .logo-link:hover {
    border-color: rgba(6, 182, 212, 0.3);
    background: rgba(6, 182, 212, 0.08);
  }

  .logo-link[data-home="true"] {
    border-color: rgba(6, 182, 212, 0.3);
    background: rgba(6, 182, 212, 0.12);
  }
</style>
