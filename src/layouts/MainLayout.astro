---
import BaseHead from "~/components/common/BaseHead.astro";
import MorphedNavigationItems from "~/components/navigation/MorphedNavigationItems.astro";
import LOGO from "~/assets/Logo.astro";
import ChatButton from "~/components/vue-components/ChatButton.vue";

interface Props {
  title: string;
  /**
   * to be concantinated with the default meta description
   */
  metaDescription?: string;
}

const { title: layoutTitle, metaDescription } = Astro.props;
---

<!doctype html>
<html lang="en">
  <BaseHead title={layoutTitle} metaDescription={metaDescription} />

  <body>
    <main transition:animate="none">
      <header
        class="page-container margin-block-500 flex vertical-align-center horizontal-align-between"
      >
        <a
          href="/"
          class=""
          style=" display: flex; align-items: center; gap: 0.5rem;"
        >
          <span class="sr-only">avik banik logo</span>
          <LOGO height={50} width={50} />
        </a>

        <nav transition:persist="">
          <MorphedNavigationItems />
        </nav>
      </header>

      <div transition:animate="fade" id="main-content">
        <slot />
      </div>
    </main>

    <ChatButton client:load transition:persist />
  </body>
</html>

<style is:global>
  /* general styling */
  body {
    font-size: var(--fs-body);
    font-family: var(--ff-body);
    color: var(--clr-neutral);
  }

  p:not([class]) {
    opacity: 0.7;
    max-width: 32ch;
  }

  p[data-width="wide"] {
    max-width: 50ch;
  }
</style>

<!-- TODO: refactor button styles -->
<style>
  :root {
    /* colors aligned to global tokens */
    --color-primary-hsl: 204, 86%, 55%;
    --color-primary-light-hsl: 204, 92%, 64%;
    --color-primary-darker-hsl: 204, 70%, 45%;
    --color-bg-hsl: 0, 0%, 100%;
    --color-bg-dark-hsl: 222, 47%, 97%;
    --color-contrast-higher-hsl: 220, 14%, 23%;
    --color-white-hsl: 0, 0%, 100%;
  }

  /* buttons */
  .btn {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-size: 1em;
    white-space: nowrap;
    text-decoration: none;
    background: hsl(var(--color-bg-dark-hsl));
    color: hsl(var(--color-contrast-higher-hsl));
    cursor: pointer;
    line-height: 1.2;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: all 0.18s ease;
    will-change: transform;
    border-radius: 999px;
    border: 1px solid hsla(var(--color-contrast-higher-hsl), 0.08);
    padding: 0.65rem 1.25rem;
  }

  .btn:focus-visible {
    box-shadow:
      0px 0px 0px 2px hsl(var(--color-bg-hsl)),
      0px 0px 0px 4px hsla(var(--color-contrast-higher-hsl), 0.12);
    outline: none;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--primary {
    background: hsl(var(--color-primary-hsl));
    color: hsl(var(--color-white-hsl));
    box-shadow: none;
  }

  .btn--primary:hover {
    background: hsl(var(--color-primary-light-hsl));
  }

  .btn--primary:focus {
    box-shadow:
      0px 0px 0px 2px hsl(var(--color-bg-hsl)),
      0px 0px 0px 4px hsla(var(--color-primary-hsl), 0.4);
  }
</style>
