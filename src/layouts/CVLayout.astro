---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag> = Polymorphic<{ 
  as: Tag,
}>;

const {
  as: Element='section',
  class: providerClass,
  ...props
} = Astro.props;

---

<Element
  class:list={[ providerClass]} 
  {...props}
>
    <article class='cv-article page-container margin-block-700 padding-400'>
        <slot />
    </article>
</Element>

<style>
.cv-article {
    position: relative;
    border: 1px solid #ccc;
    background-color: white;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    border-radius: 8px;
    overflow: hidden;
    transition: box-shadow 0.3s ease, transform 0.3s ease; /* Add transition for smooth effect */
}


.cv-article:hover {
  box-shadow: 0 8px 16px rgba(0,0,0,0.2); /* More prominent shadow */
  transform: scale(1.005); /* Slightly scale up */
}
</style>